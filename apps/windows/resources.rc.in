#include <windows.h>
1 ICON "@CMAKE_SOURCE_DIR@/assets/generated/Snapliq-dark.ico"
2 ICON "@CMAKE_SOURCE_DIR@/assets/generated/Snapliq-black.ico"
3 ICON "@CMAKE_SOURCE_DIR@/assets/generated/Snapliq-white.ico"

1 VERSIONINFO
FILEVERSION @SNAPLIQ_VERSION_COMMA@,0
PRODUCTVERSION @SNAPLIQ_VERSION_COMMA@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@SNAPLIQ_NAME@ - Capture. Record. Share.\0"
   VALUE "FileVersion", "@SNAPLIQ_VERSION@.0\0"
   VALUE "InternalName", "Snapliq\0"
   VALUE "OriginalFilename", "Snapliq.exe\0"
   VALUE "ProductName", "@SNAPLIQ_NAME@\0"
   VALUE "ProductVersion", "@SNAPLIQ_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
